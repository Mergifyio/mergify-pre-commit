{
  "extends": ["config:base"],
  "minimumReleaseAge": "7 days",
  "regexManagers": [
    {
      "fileMatch": ["^\\.pre-commit-hooks\\.yaml$"],
      "matchStrings": [
        "(?m)^\\s*-\\s*(?<depName>[A-Za-z0-9_.-]+)==(?<currentValue>[^\\s#]+)\\s*$"
      ],
      "datasourceTemplate": "pypi"
    }
  ]
}
